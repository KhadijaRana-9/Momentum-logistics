# ─────────────────────────────────────────────────────────────────────────────
#  Momentum Logistics — environment variables
#  Copy to `.env.local` for local dev (`vercel dev`) and set the same keys in
#  the Vercel project dashboard for preview/production. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server-only (never exposed to the browser) ──────────────────────────────

# MongoDB Atlas connection string (SRV). Create a free cluster at
# https://cloud.mongodb.com → Connect → Drivers → Node.js.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=momentum"
MONGODB_DB="momentum"

# Auth — generate a long random string: `openssl rand -base64 48`
AUTH_JWT_SECRET=""
AUTH_JWT_EXPIRES_IN="7d"
# Optional: set only if the app is served from a subdomain and you need the
# session cookie shared across it.
# AUTH_COOKIE_DOMAIN=".momentum-logistics.com"

# One-time bootstrap secret for POST /api/users?scope=seed (creates the first admin).
# Remove or rotate after initial setup.
SEED_SECRET=""

# ── Dev/staging test accounts (scripts/seed-dev-users.mjs) ──────────────────
# Only for local/staging databases — the script refuses to run when
# NODE_ENV=production, no matter what else is set. Passwords: pick your own
# strong dev-only values (10+ chars); never commit real values here.
# SEED_PARTNER_PASSWORD / SEED_CUSTOMER_PASSWORD are placeholders for the
# future — no partner or customer role exists in this app yet, so the script
# does not create those two accounts (see docs/SEED_ACCOUNTS.md).
SEED_SUPER_ADMIN_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_PARTNER_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""

# ── Email (optional — lead capture works without it) ────────────────────────
# Supported provider: "resend". Leave blank to disable outbound email; the app
# reports email as "not configured" rather than pretending mail was sent.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="Momentum Logistics <hello@momentum-logistics.com>"
SALES_NOTIFICATION_EMAIL="sales@momentum-logistics.com"

# ── AI chatbot (optional — architecture is ready, no provider wired) ────────
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""

# ── Client-side (VITE_ prefix = shipped to the browser; non-secret only) ────
VITE_API_BASE="/api"
VITE_SITE_URL="https://momentum-logistics.vercel.app"

# Analytics / retargeting — leave blank to keep all third-party tags disabled.
VITE_TRACKING_ENABLED="false"
VITE_GA4_ID=""
VITE_GOOGLE_ADS_ID=""
VITE_GOOGLE_ADS_DEMO_LABEL=""
VITE_META_PIXEL_ID=""

VITE_CHATBOT_ENABLED="true"
